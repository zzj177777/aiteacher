# DeepSeek configuration. Never put keys in VITE_* variables.
# The endpoint is a full URL, not a base URL.
AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-flash

# Optional cost estimation. Rates are per 1,000,000 tokens, in the currency below.
# Use your provider/account prices. Blank means unknown, never free.
AI_PRICE_MODEL=
AI_PRICE_CURRENCY=CNY
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
# Optional cache-hit input rate; omit to use standard input rate for all input.
# AI_CACHE_HIT_PRICE_PER_MILLION=
